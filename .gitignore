# ── 데이터셋 (18.3GB · 15만 파일) ──────────────────────
# NOMAD/WiSARD 는 각자 라이선스가 있는 공개 연구 데이터셋이다.
# 재배포하지 않는다. 원본을 받아 nomad_prep.py / wisard_prep.py 로 만든다.
data/

# ── 학습 산출물 ──────────────────────────────────────
runs_person/
weights/
*.pt

# ── 실행 결과 ────────────────────────────────────────
results/
maps/
logs/
_backup/

# ── 파이썬 ───────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── 실행 중 자동 생성 (절대 경로가 박혀 다른 PC 에서 깨진다) ──
metrics/_lists/

# ── 발표용 이미지 (약 60MB · 코드 실행과 무관) ──
comparison/
figures/

# ── 로컬 전용 ──
*.lnk
